# ==============================================================================
# DBB CONNECT - PRODUCTION ENVIRONMENT (.env.production)
# ==============================================================================
# This file is loaded automatically by Vite during `npm run build`.
# When building for production, set VITE_API_URL to your actual production
# Laravel API domain (or pass it via your CI/CD build command).
#
# Examples:
# VITE_API_URL=https://api.yourdomain.com
# VITE_API_URL=https://backend.example.com

VITE_API_URL=https://<production-api-domain>
VITE_APP_NAME="DBB Connect"
