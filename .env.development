# ==============================================================================
# DBB CONNECT - DEVELOPMENT / NETWORK TESTING ENVIRONMENT (.env.development)
# ==============================================================================
# This file is loaded automatically by Vite during `npm run dev`.
# It provides the development API URL for LAN or Tailscale multi-device testing.

# LAN testing (e.g. from another PC or smartphone connected to the same Wi-Fi / LAN):
VITE_API_URL=http://192.168.1.38:8000

# Tailscale testing (if testing across remote machines on your Tailnet, switch to this):
VITE_API_URL=http://100.87.162.99:8000

# Local testing only (single PC):
VITE_API_URL=http://100.87.162.99:8000

VITE_APP_NAME="DBB Connect (Dev)"
