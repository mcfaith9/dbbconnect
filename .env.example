# ==============================================================================
# DBB CONNECT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND (Vite / Vue 3)
# These variables are read by Vite and embedded at build/development time.
# ------------------------------------------------------------------------------
# Development LAN testing: http://192.168.1.38:8000
# Development Tailscale:   http://100.87.162.99:8000
# Production:              https://<production-api-domain>
VITE_API_URL=http://192.168.1.38:8000
VITE_APP_NAME="DBB Connect"

# ------------------------------------------------------------------------------
# BACKEND (Laravel 11 / Sanctum)
# Server-side configuration - never exposed to browser
# ------------------------------------------------------------------------------
APP_NAME="DBB Connect"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://192.168.1.38:8000

# Permitted Frontend Origins for CORS (comma-separated list)
# In development: includes localhost, LAN IP (192.168.1.38:5173), and Tailscale IP (100.87.162.99:5173)
# In production:  set to your production frontend URL (e.g. https://app.example.com)
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.38:5173,http://100.87.162.99:5173

# Database (MySQL)
# In development: Keep DB_HOST=127.0.0.1 (Laravel connects locally to MySQL on PC #1)
# In production: Set to your production MySQL host, username, and password
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dbbconnect
DB_USERNAME=root
DB_PASSWORD=

# Laravel Sanctum (Stateful Domains)
# CRITICAL: Keep empty for stateless Bearer token authentication (Authorization: Bearer <token>)
# Do not add frontend domains here, or Sanctum will enforce CSRF validation on API routes.
SANCTUM_STATEFUL_DOMAINS=

# Session / Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
LOG_CHANNEL=stack
LOG_LEVEL=debug
